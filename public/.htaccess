# Hostinger Apache/LiteSpeed: publish dist only, never the source checkout.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:site|app)[.]zip$ - [F,L,NC]
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:src|tests|supabase|docs|scripts|node_modules)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:package(?:-lock)?\.json|vite\.config\.[^/]+|tsconfig[^/]*\.json|README\.md)$ - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule \.[^/]+$ - [R=404,L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
